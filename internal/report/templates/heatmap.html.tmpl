{{/* heatmap is the endpoint x profile matrix, shared by report.html.tmpl and the UI results page. */}}
{{define "heatmap"}}<ul class="legend" aria-label="Legend">
{{- range .Legend}}
<li class="cell {{.Class}}"><i aria-hidden="true">{{.Glyph}}</i> {{.Label}}</li>
{{- end}}
</ul>
<div class="scroll" tabindex="0" role="region" aria-label="Endpoint by profile matrix">
<table>
<thead><tr><th scope="col">Endpoint</th>{{range .Profiles}}<th scope="col">{{.}}</th>{{end}}</tr></thead>
<tbody>
{{- range .Rows}}
<tr><th scope="row">{{.Endpoint}}</th>{{range .Cells}}<td class="hm"><div class="cell {{.Class}}"><i aria-hidden="true">{{.Glyph}}</i> {{.Label}}</div></td>{{end}}</tr>
{{- end}}
</tbody>
</table>
</div>{{end}}
