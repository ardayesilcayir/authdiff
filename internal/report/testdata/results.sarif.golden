            "victim": "alice"
          }
        },
        {
          "ruleId": "AD-BOLA-001",
          "ruleIndex": 0,
          "level": "error",
          "message": {
            "text": "Cross-user object read (bob → alice)"
          },
          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": {
                  "uri": "specs/openapi.yaml"
