{
  "$schema": "https://json.schemastore.org/sarif-2.1.0.json",
  "runs": [
    {
      "results": [
        {
          "ruleId": "AD-NOAUTH-001",
          "ruleIndex": 1,
          "level": "error",
          "message": {
            "text": "Endpoint reachable without authentication (alice → anon)"
          },
          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": {
                  "uri": "specs/openapi.yaml"
                },
                "region": {
                  "startLine": 12
                }
              }
            }
          ],
          "partialFingerprints": {
            "authdiffFindingId": "aaaaaaaaaaaa"
          },
          "properties": {
            "attacker": "anon",
            "confidence": "high",
            "similarity": 0.97,
            "victim": "alice"
          }
        },
        {
          "ruleId": "AD-BOLA-001",
          "ruleIndex": 0,
          "level": "error",
          "message": {
            "text": "Cross-user object read (alice → bob)"
          },
          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": {
                  "uri": "specs/openapi.yaml"
                },
                "region": {
                  "startLine": 1
                }
              }
            }
