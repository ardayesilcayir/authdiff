          "properties": {
            "attacker": "alice",
            "confidence": "low",
            "similarity": 0.88,
            "victim": "bob"
          },
          "suppressions": [
            {
              "kind": "external"
            }
          ]
        }
      ],
      "tool": {
        "driver": {
          "informationUri": "https://github.com/ardayesilcayir/authdiff",
          "name": "authdiff",
          "rules": [
            {
              "id": "AD-BOLA-001",
              "name": "BrokenObjectLevelAuthorization",
              "shortDescription": {
                "text": "BrokenObjectLevelAuthorization"
              },
              "fullDescription": {
                "text": "Another user can read an object they do not own."
              },
              "helpUri": "https://github.com/ardayesilcayir/authdiff/blob/main/docs/rules/AD-BOLA-001.md",
              "defaultConfiguration": {
                "level": "error"
              },
              "properties": {
                "security-severity": "8.1",
                "tags": [
